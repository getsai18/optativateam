# --- Base de facturación (RDS MySQL): clientes, usuarios, emisor, facturas, pagos, folios
BILLING_DB_ENGINE=mysql
BILLING_DB_HOST=127.0.0.1
BILLING_DB_PORT=3306
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing
BILLING_DB_PASSWORD=

# --- Base de catálogo (RDS Postgres): servicios, características, impuestos, historial de tasas
# Si CATALOG_DB_HOST se deja vacío, el catálogo se lee de la base de facturación (modo una sola base).
CATALOG_DB_ENGINE=postgres
CATALOG_DB_HOST=
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

JWT_SECRET=cambia-esto-por-32-bytes-aleatorios-minimo
SESSION_TTL_MS=1800000
# Solo local: con ALLOW_DEMO_LOGIN=true, hashes no-bcrypt del seed aceptan DEMO_PASSWORD.
DEMO_PASSWORD=demo1234
ALLOW_DEMO_LOGIN=true
# EC2/producción: APP_ENV=production, backends dynamodb (rol IAM de la instancia), TRUSTED_PROXIES=1 tras nginx/ALB
APP_ENV=development
TRUSTED_PROXIES=0
CART_BACKEND=memory
CART_TABLE=billing_invoice_cart
AUDIT_BACKEND=memory
AUDIT_TABLE=billing_audit_log
AUDIT_REQUIRED=false
CORS_ORIGINS=http://localhost:5173
