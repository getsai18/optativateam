# --- Base de facturación (RDS MySQL): clientes, usuarios, emisor, facturas, pagos, folios
BILLING_DB_ENGINE=mysql
BILLING_DB_HOST=127.0.0.1
BILLING_DB_PORT=3306
BILLING_DB_NAME=Facturacion_Mysql
BILLING_DB_USER=billing
BILLING_DB_PASSWORD=

# --- Base de catálogo (RDS Postgres): servicios, características, impuestos, historial de tasas
# Si CATALOG_DB_HOST se deja vacío, el catálogo se lee de la base de facturación (modo una sola base).
CATALOG_DB_ENGINE=postgres
CATALOG_DB_HOST=
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=postgres
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

JWT_SECRET=cambia-esto-por-32-bytes-aleatorios-minimo
SESSION_TTL_MS=1800000
DEMO_PASSWORD=demo1234
ALLOW_DEMO_LOGIN=false
AUDIT_BACKEND=memory
AUDIT_TABLE=billing_audit_log
AUDIT_REQUIRED=false
# Solo desarrollo local; en producción pon el dominio real del frontend (separado por comas si hay varios).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Límite de login distribuido (tabla billing_user_session, TTL 900 s) -------------------
# Sin DYNAMODB_ENDPOINT se usa el endpoint AWS por defecto; en local, sin endpoint, se usa
# el contador en memoria. DYNAMODB_RATE_LIMIT=1 fuerza DynamoDB (útil con DynamoDB Local).
DYNAMODB_RATE_LIMIT=0
DYNAMODB_ENDPOINT=
USER_SESSION_TABLE=billing_user_session
