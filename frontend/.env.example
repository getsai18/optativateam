# Backend Flask local (sin barra final)
VITE_API_URL=http://127.0.0.1:5000
# API Gateway de las Lambdas en AWS (cart, authorizer), sin barra final y sin /stage. Ejemplo:
# VITE_LAMBDA_URL=https://abc123.execute-api.us-east-1.amazonaws.com
VITE_LAMBDA_URL=https://ip7ksnqkza.execute-api.us-east-1.amazonaws.com
# Las Lambdas se llaman solo con true (apagado: el carrito queda en localStorage).
VITE_LAMBDA_ENABLED=false
